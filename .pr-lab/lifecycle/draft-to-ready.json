{
  "schema_version": 1,
  "id": "draft-to-ready",
  "purpose": "Observe a draft pull request becoming ready without changing its deterministic content scenario.",
  "content_scenario": {
    "id": "clean-green",
    "manifest": ".pr-lab/scenarios/clean-green/scenario.json"
  },
  "initial_provider_state": {
    "pull_request": "open",
    "head_branch": "present",
    "readiness": "draft",
    "base_relation": "current",
    "mergeability": "mergeable",
    "collaboration": "maintainer-edits",
    "review": "pending"
  },
  "operator_actions": [
    {
      "id": "mark-ready",
      "actor": "author",
      "operation": "mark-ready"
    }
  ],
  "expected_transitions": [
    {
      "after_action": "mark-ready",
      "field": "readiness",
      "from": "draft",
      "to": "ready"
    }
  ],
  "completion_conditions": [
    {
      "field": "readiness",
      "equals": "ready"
    }
  ],
  "cleanup_expectations": [
    {
      "id": "close-pull-request",
      "actor": "operator",
      "operation": "close-pull-request",
      "field": "pull_request",
      "from": "open",
      "to": "closed"
    },
    {
      "id": "delete-head-branch",
      "actor": "operator",
      "operation": "delete-head-branch",
      "field": "head_branch",
      "from": "present",
      "to": "deleted"
    }
  ]
}
